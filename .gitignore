# All script output: renders, decoded WAVs, extracted sample banks, scratch.
# Everything in here is regenerable — see scripts/shared/_paths.py for how.
output/*
!output/.gitkeep
!output/README.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Game data never belongs in the repo (it is next to it, in ../data and ../modules)
*.s3v
*.s3p
*.2dx
*.dll
*.exe

# Bulk audio. The one exception is the cabinet capture used for calibration,
# which is small, irreplaceable, and force-added under scripts/audio/reference/.
*.wav
*.mp3
*.ogg
!scripts/audio/reference/*.ogg

# GUI build artifacts - regenerable via build/build_assets.py + build/build.py.
# gui/assets/ holds the staged SE bank + ffmpeg binary (see build_assets.py's
# docstring for why those are the only two things fetched from outside the repo).
gui/assets/
build/dist/
build/work/
build/*.log

# Editor / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

*.ksh
*.png
*.jpg